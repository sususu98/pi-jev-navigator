{
  "name": "pi-jev-navigator",
  "version": "1.0.0",
  "description": "Ultra-low-token System One context navigation and precision SOP dispatch engine for Pi Coding Agent using TypeSafe Jev & Trie-Folded CodeGraphs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "bin": {
    "jev-graph": "scripts/jev-graph.cjs"
  },
  "files": [
    "dist",
    "bin/native",
    "scripts/jev-graph.cjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build:ts": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && bun build src/index.ts --outfile dist/index.js --target node --format esm --external @earendil-works/pi-coding-agent && tsc --emitDeclarationOnly",
    "build:native": "node scripts/build-native.mjs",
    "build": "bun run build:ts && bun run build:native",
    "typecheck": "tsc --noEmit",
    "watch": "tsc --noEmit --watch",
    "test": "bun test",
    "test:native": "go test ./cmd/jev-graph",
    "format": "prettier --write 'src/**/*.ts' 'tests/**/*.ts'",
    "prepack": "bun run build",
    "prepublishOnly": "bun run typecheck && bun test && bun run test:native",
    "pack:check": "bun run build && node scripts/check-package.mjs"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": ["./dist/index.js"]
  },
  "keywords": [
    "pi",
    "pi-extension",
    "pi-package",
    "typesafe",
    "jev",
    "system-one",
    "codegraph",
    "gitnexus",
    "context-governance",
    "trie-dsl"
  ],
  "author": "sususu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sususu98/pi-jev-navigator.git"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.87.1 <1"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@types/node": "^22.13.0",
    "prettier": "^3.9.9",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1",
    "yaml": "^2.9.1"
  }
}
